<!DOCTYPE template>
<!--
  Description:
    A grid of hotcue controls. The visible count is selected via a
    WidgetStack driven by the [Skin],hotcue_count control, with one
    exclusive trigger CO per option ([Skin],show_N_hotcues).
  Variables:
    group: The group for the controls.
-->
<Template>
  <WidgetGroup>
    <Layout>horizontal</Layout>
    <SizePolicy>me,min</SizePolicy>
    <Children>
      <WidgetStack currentpage="[Skin],hotcue_count" persist="true">
        <Children>
          <Template trigger="[Skin],show_4_hotcues" on_hide_select="1" src="skin:hotcues_4.xml"/>
          <Template trigger="[Skin],show_8_hotcues" src="skin:hotcues_8.xml"/>
          <Template trigger="[Skin],show_16_hotcues" src="skin:hotcues_16.xml"/>
          <Template trigger="[Skin],show_24_hotcues" src="skin:hotcues_24.xml"/>
          <Template trigger="[Skin],show_36_hotcues" on_hide_select="0" src="skin:hotcues_36.xml"/>
        </Children>
      </WidgetStack>
    </Children>
    <Connection>
      <ConfigKey>[Skin],show_hotcues</ConfigKey>
      <BindProperty>visible</BindProperty>
    </Connection>
  </WidgetGroup>
</Template>
