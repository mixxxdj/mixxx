<!DOCTYPE template>
<!--
  Description:
    Compact 2-state skin settings toggle for selecting one of several
    exclusive options. The button appears active when the bound control
    equals the IsEqual value.
  Variables:
    Text    : label text for the button
    Setting : persistent skin setting control
    IsEqual : value the control is compared against for the active state
    Width   : button width
-->
<Template>
  <PushButton>
    <ObjectName>SkinSettingsNumToggle</ObjectName>
    <Size><Variable name="Width"/>,18f</Size>
    <NumberStates>2</NumberStates>
    <State>
      <Number>0</Number>
      <Text><Variable name="Text"/></Text>
      <Alignment>center</Alignment>
    </State>
    <State>
      <Number>1</Number>
      <Text><Variable name="Text"/></Text>
      <Alignment>center</Alignment>
    </State>
    <Connection>
      <ConfigKey persist="true"><Variable name="Setting"/></ConfigKey>
      <Transform><IsEqual><Variable name="IsEqual"/></IsEqual></Transform>
      <ButtonState>LeftButton</ButtonState>
    </Connection>
  </PushButton>
</Template>
