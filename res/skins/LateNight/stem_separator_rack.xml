                        </Connection>
                      </SliderComposed>
                      <PushButton>
                        
                        <ObjectName>StemMuteButton</ObjectName>
                        <Size>18f,16f</Size>
                        <NumberStates>2</NumberStates>
                        <State>
                          <Number>0</Number>
