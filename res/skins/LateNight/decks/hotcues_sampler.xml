<Template>
  <WidgetGroup>
    <Layout>horizontal</Layout>
    <SizePolicy>max,me</SizePolicy>
    <Children>

      <WidgetStack currentpage="[Skin],hotcue_count" persist="true">
        <Children>
          <Template trigger="[Skin],show_4_hotcues" on_hide_select="1" src="skins:LateNight/decks/hotcues_4_sampler.xml"/>
          <Template trigger="[Skin],show_8_hotcues" src="skins:LateNight/decks/hotcues_8_sampler.xml"/>
          <Template trigger="[Skin],show_16_hotcues" on_hide_select="1" src="skins:LateNight/decks/hotcues_16_sampler.xml"/>
        </Children>
      </WidgetStack>

    </Children>
    <Connection>
      <ConfigKey>[Skin],show_hotcues</ConfigKey>
      <BindProperty>visible</BindProperty>
    </Connection>
  </WidgetGroup>
</Template>
