+    
+    qWarning() << "DragBegin::DragBegin:" << startMousePoint.x << startMousePoint.y << endMousePoint.x << endMousePoint.y;
+
+    env.scene().events().mouseMove(start.get(), startMousePoint);
+    QTime dieTime = QTime::currentTime().addMSecs(50);
+    while (QTime::currentTime() < dieTime)
