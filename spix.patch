new file mode 100644
index 0000000..ae5d62f
--- /dev/null
+++ b/libs/Core/src/Commands/Drag.cpp
@@ -0,0 +1,58 @@
+/***
+ * Copyright (C) Falko Axmann. All rights reserved.
+ * Licensed under the MIT license.
+ * See LICENSE.txt file in the project root for full license information.
+ ****/
+
+#include "Drag.h"
+
+#include <Spix/Scene/Scene.h>
+#include <QTime>
+#include <QEventLoop>
+#include <QCoreApplication>
+
+namespace spix {
+namespace cmd {
+
+Drag::Drag(ItemPosition startPath, Point delta, uint time)
+: m_startPath(std::move(startPath)), m_delta(std::move(delta)), m_time(time)
+{
+}
+
+void Drag::execute(CommandEnvironment& env)
+{
+    auto path = env.scene().itemAtPath(m_startPath.itemPath());
+
+    if (!path) {
+        env.state().reportError("Drag: Item not found: " + m_startPath.itemPath().string());
+        return;
+    }
+
+    auto startMousePoint = m_startPath.positionForItemSize(path->size());
+    
+    qWarning() << "Drag::Drag:" << startMousePoint.x << startMousePoint.y << m_delta.x << m_delta.y;
+
+    env.scene().events().mouseMove(path.get(), startMousePoint);
+    QTime dieTime = QTime::currentTime().addMSecs(50);
+    while (QTime::currentTime() < dieTime)
+        QCoreApplication::processEvents(QEventLoop::AllEvents, 50);
+    env.scene().events().mouseDown(path.get(), startMousePoint, MouseButtons::Left, KeyModifiers::None);
+    dieTime = QTime::currentTime().addMSecs(50);
+    while (QTime::currentTime() < dieTime)
+        QCoreApplication::processEvents(QEventLoop::AllEvents, 50);
+    Point currentMousePoint(0, 0);
+    for (int i = 0; i <= 10; i++) {
+        if (i < 2) {
+            currentMousePoint.x +=  m_delta.x / 10;
+            currentMousePoint.y +=  m_delta.y / 10;
+        }
+        env.scene().events().mouseMove(path.get(), currentMousePoint);
+        dieTime = QTime::currentTime().addMSecs(m_time / 10);
+        while (QTime::currentTime() < dieTime) {}
+            QCoreApplication::processEvents(QEventLoop::AllEvents, m_time / 10);
+    }
+    env.scene().events().mouseUp(path.get(), startMousePoint, MouseButtons::Left, KeyModifiers::None);
+}
+
+} // namespace cmd
+} // namespace spix
