+    env.scene().events().mouseDown(start.get(), startMousePoint, MouseButtons::Left, KeyModifiers::None);
+    dieTime = QTime::currentTime().addMSecs(50);
+    while (QTime::currentTime() < dieTime)
+        QCoreApplication::processEvents(QEventLoop::AllEvents, 50);
+    for (int i = 0; i < 3; i++) {
+        env.scene().events().mouseMove(i % 2 == 0 ? start.get() : end.get(), i % 2 == 0 ? startMousePoint : endMousePoint);
