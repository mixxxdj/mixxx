#!/usr/bin/env bash
# The desktop file must use Exec=mixxx (CPack AppImage requires a plain
# basename), so the pasuspender convenience is reproduced here instead.
set -e

this_dir="$(readlink -f "$(dirname "$0")")"

# pasuspender propagates the launched command's exit status, so we cannot
# use its result as a retry signal (a Mixxx crash would relaunch it).  Only
# use pasuspender when a PulseAudio server is actually reachable; otherwise
# launch Mixxx plainly.
if command -v pasuspender >/dev/null 2>&1 \
   && command -v pactl >/dev/null 2>&1 \
   && pactl info >/dev/null 2>&1; then
  exec pasuspender -- "$this_dir/bin/mixxx" "$@"
fi

exec "$this_dir/bin/mixxx" "$@"
